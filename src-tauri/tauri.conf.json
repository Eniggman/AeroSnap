{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroSnap 2.0",
  "version": "2.0.0",
  "identifier": "com.aerosnap.app",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
